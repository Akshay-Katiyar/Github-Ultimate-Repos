{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepositoryComparisonMatrix",
  "description": "Schema definition for multi-repository trade-off and comparison evaluations",
  "type": "object",
  "required": [
    "comparison_id",
    "timestamp",
    "repository_count",
    "repositories",
    "tradeoff_analysis"
  ],
  "properties": {
    "comparison_id": {
      "type": "string",
      "description": "Unique identifier for this comparison evaluation"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of evaluation"
    },
    "repository_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3,
      "description": "Number of evaluated repositories (2 or 3)"
    },
    "repositories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "name",
          "url",
          "stars",
          "forks",
          "language",
          "category",
          "primary_use_case_fit",
          "architectural_approach",
          "strengths_and_advantages",
          "limitations_and_bottlenecks",
          "ideal_developer_persona",
          "licensing_and_deployment",
          "scores"
        ],
        "properties": {
          "identifier": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "stars": {
            "type": "integer",
            "minimum": 0
          },
          "forks": {
            "type": "integer",
            "minimum": 0
          },
          "language": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "primary_use_case_fit": {
            "type": "object",
            "required": ["summary", "sweet_spot", "anti_patterns"],
            "properties": {
              "summary": { "type": "string" },
              "sweet_spot": {
                "type": "array",
                "items": { "type": "string" }
              },
              "anti_patterns": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "architectural_approach": {
            "type": "object",
            "required": ["paradigm", "execution_model", "state_management", "tool_routing"],
            "properties": {
              "paradigm": { "type": "string" },
              "execution_model": { "type": "string" },
              "state_management": { "type": "string" },
              "tool_routing": { "type": "string" }
            }
          },
          "strengths_and_advantages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "limitations_and_bottlenecks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "ideal_developer_persona": {
            "type": "object",
            "required": ["title", "profile", "cognitive_overhead"],
            "properties": {
              "title": { "type": "string" },
              "profile": { "type": "string" },
              "cognitive_overhead": {
                "type": "string",
                "enum": ["Low", "Moderate", "High", "Very High"]
              }
            }
          },
          "licensing_and_deployment": {
            "type": "object",
            "required": ["license", "commercial_use", "deployment_models", "operational_footprint"],
            "properties": {
              "license": { "type": "string" },
              "commercial_use": { "type": "string" },
              "deployment_models": {
                "type": "array",
                "items": { "type": "string" }
              },
              "operational_footprint": { "type": "string" }
            }
          },
          "scores": {
            "type": "object",
            "required": [
              "production_readiness",
              "architectural_modularity",
              "velocity_ease_of_adoption",
              "ecosystem_integrations",
              "operational_efficiency",
              "composite_score"
            ],
            "properties": {
              "production_readiness": { "type": "integer", "minimum": 0, "maximum": 100 },
              "architectural_modularity": { "type": "integer", "minimum": 0, "maximum": 100 },
              "velocity_ease_of_adoption": { "type": "integer", "minimum": 0, "maximum": 100 },
              "ecosystem_integrations": { "type": "integer", "minimum": 0, "maximum": 100 },
              "operational_efficiency": { "type": "integer", "minimum": 0, "maximum": 100 },
              "composite_score": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    "tradeoff_analysis": {
      "type": "object",
      "required": [
        "decision_guide",
        "scenario_recommendations",
        "comparative_summary"
      ],
      "properties": {
        "decision_guide": {
          "type": "object",
          "description": "Rule-based selection guides for each evaluated repository"
        },
        "scenario_recommendations": {
          "type": "object",
          "description": "Best fit recommendation per development scenario"
        },
        "comparative_summary": {
          "type": "string",
          "description": "Executive synthesis of the trade-off evaluation"
        }
      }
    }
  }
}
